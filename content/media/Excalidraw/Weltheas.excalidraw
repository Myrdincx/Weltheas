      "type": "text",
      "x": 1673.722222222222,
      "y": -328.45634920634876,
      "width": 370.8166809082031,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
