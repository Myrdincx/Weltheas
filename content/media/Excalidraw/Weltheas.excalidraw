      "isDeleted": false,
      "boundElements": [],
      "updated": 1766182773520,
      "link": null,
      "locked": false,
      "text": "* While the Advisor doesn't have a say in the making of actual laws, \nthey hold a position to advise the Chairpersons in favour of the Welthean citizens.\nCurrent idea: Citizens can send proposals to the Advisor. The Advisor is able to amend or keep the proposal as is,\nand sends it over to the Council.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* While the Advisor doesn't have a say in the making of actual laws, \nthey hold a position to advise the Chairpersons in favour of the Welthean citizens.\nCurrent idea: Citizens can send proposals to the Advisor. The Advisor is able to amend or keep the proposal as is,\nand sends it over to the Council.",
      "autoResize": true,
      "lineHeight": 1.25
    },
