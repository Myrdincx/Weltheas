      "seed": 1659724211,
      "version": 509,
      "versionNonce": 756078375,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766182773520,
      "link": null,
      "locked": false,
      "text": "*The Crisis Council only operates in cases of Crisis. \nIn any other case, the normal Council operates.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*The Crisis Council only operates in cases of Crisis. \nIn any other case, the normal Council operates.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "5R4hZGigx5psORN4sM9Je",
      "type": "text",
      "x": 1675.8138817681204,
      "y": -387.20634920634876,
      "width": 427.4666748046875,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0o",
      "roundness": null,
      "seed": 217676189,
      "version": 659,
      "versionNonce": 1264147015,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766182773520,
      "link": null,
      "locked": false,
      "text": "*The Council (consisting out of Chairpersons) is the leading\npower in Weltheas. ",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*The Council (consisting out of Chairpersons) is the leading\npower in Weltheas. ",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "SyemTKI-TvJo_4qPb52At",
      "type": "text",
      "x": 1676.222222222222,
      "y": -278.45634920634876,
      "width": 512.3499755859375,
      "height": 40,
      "angle": 0,
      "strokeColor": "#f08c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dotted",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 1162343837,
      "version": 301,
      "versionNonce": 266631527,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1766182773520,
      "link": null,
      "locked": false,
      "text": "*The Magistrates consist out of 3/5 members of the council and uphold\nthe law as judges.",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "*The Magistrates consist out of 3/5 members of the council and uphold\nthe law as judges.",
      "autoResize": true,
      "lineHeight": 1.25
    },
    {
      "id": "lM78Pkd7DSQ0GITBqo1GR",
